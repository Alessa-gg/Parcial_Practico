@{
    var rol = Context.Session.GetString("Rol");
    var usuario = Context.Session.GetString("Username");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EquiposReportes</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Reportes" asp-action="Inventario">EquiposReportes</a>
                <div class="navbar-collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (rol == "Admin")
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Reportes" asp-action="Inventario">Inventario por categoría</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Reportes" asp-action="Vencidos">Préstamos vencidos</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Reportes" asp-action="Top">Top 5 equipos</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Reportes" asp-action="Historial">Historial por usuario</a></li>
                        }
                    </ul>
                    @if (rol == "Admin")
                    {
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="d-flex align-items-center gap-2">
                            <span class="text-muted">@usuario (@rol)</span>
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Cerrar sesión</button>
                        </form>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
