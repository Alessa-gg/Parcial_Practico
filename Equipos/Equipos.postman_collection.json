{
  "info": {
    "name": "Equipos - Pruebas Persona B",
    "description": "Casos 1, 2, 3, 4, 5 y 10 del parcial. Ejecutar en orden con el Collection Runner. Defina adminPass y estudiantePass antes de ejecutar; no guarde contraseñas reales en el repositorio.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Preparación",
      "item": [
        {
          "name": "Login Admin (guarda token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUser}}\",\n  \"password\": \"{{adminPass}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Devuelve token y rol Admin', () => { pm.expect(j.token).to.be.a('string').and.not.empty; pm.expect(j.rol).to.eql('Admin'); });",
                  "pm.collectionVariables.set('tokenAdmin', j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar estudiante de prueba (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{estudianteUser}}\",\n  \"password\": \"{{estudiantePass}}\",\n  \"email\": \"estudiante.prueba@equipos.local\",\n  \"rol\": \"Estudiante\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created (o 409 si ya existe)', () => pm.expect([201,409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Estudiante (guarda token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{estudianteUser}}\",\n  \"password\": \"{{estudiantePass}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Rol Estudiante', () => pm.expect(j.rol).to.eql('Estudiante'));",
                  "pm.collectionVariables.set('tokenEstudiante', j.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Caso 1",
      "item": [
        {
          "name": "Caso 1 - Login correcto devuelve token con rol",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUser}}\",\n  \"password\": \"{{adminPass}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Token JWT presente', () => pm.expect(j.token.split('.')).to.have.lengthOf(3));",
                  "const payload = JSON.parse(atob(j.token.split('.')[1].replace(/-/g,'+').replace(/_/g,'/')));",
                  "pm.test('El token incluye el rol como claim', () => pm.expect(JSON.stringify(payload)).to.include('Admin'));",
                  "pm.test('El token tiene expiración', () => pm.expect(payload.exp).to.be.a('number'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Caso 2",
      "item": [
        {
          "name": "Caso 2 - Login con contraseña incorrecta devuelve 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUser}}\",\n  \"password\": \"contraseña-incorrecta-123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Caso 3",
      "item": [
        {
          "name": "Caso 3 - Endpoint protegido sin token devuelve 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/equipos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "equipos"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Caso 4",
      "item": [
        {
          "name": "Caso 4 - Estudiante intenta crear un equipo y recibe 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/equipos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "equipos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigoInventario\": \"TEST-403\",\n  \"nombre\": \"Equipo de prueba\",\n  \"descripcion\": \"No debería crearse\",\n  \"categoriaId\": 1\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenEstudiante}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Caso 5",
      "item": [
        {
          "name": "Caso 5 - Registrar usuario con Username repetido devuelve 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{estudianteUser}}\",\n  \"password\": \"{{estudiantePass}}\",\n  \"email\": \"repetido@equipos.local\",\n  \"rol\": \"Estudiante\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Caso 10",
      "item": [
        {
          "name": "Caso 10 - Estudiante lista préstamos (solo los propios)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/prestamos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "prestamos"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenEstudiante}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const lista = pm.response.json();",
                  "pm.test('Todos los préstamos son del estudiante', () => lista.forEach(p => pm.expect(p.username).to.eql(pm.collectionVariables.get('estudianteUser'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Caso 10 - Estudiante intenta ver otros usuarios cambiando parámetros",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/prestamos?usuarioId=1&soloVencidos=false",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "prestamos"
              ],
              "query": [
                {
                  "key": "usuarioId",
                  "value": "1"
                },
                {
                  "key": "soloVencidos",
                  "value": "false"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenEstudiante}}",
                  "type": "string"
                }
              ]
            },
            "description": "El Id nunca se recibe por parámetro: el parámetro usuarioId se ignora y la API usa el Id del token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const lista = pm.response.json();",
                  "pm.test('Sigue viendo solo lo propio', () => lista.forEach(p => pm.expect(p.username).to.eql(pm.collectionVariables.get('estudianteUser'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Caso 10 - Control: Admin ve todos los préstamos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/prestamos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "prestamos"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Extra",
      "item": [
